{
  "name": "iemails",
  "version": "0.2.0",
  "description": "Official Node.js SDK and CLI for the iemails API: send email, manage domains, contacts, broadcasts, templates, webhooks and inboxes.",
  "keywords": [
    "api",
    "cli",
    "email",
    "iemails",
    "sdk",
    "smtp",
    "transactional email"
  ],
  "homepage": "https://iemails.co/docs",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Linkkit-Space/iemails-sdk.git"
  },
  "bugs": "https://github.com/Linkkit-Space/iemails-sdk/issues",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  },
  "bin": {
    "iemails": "./dist/cli.js"
  }
}
